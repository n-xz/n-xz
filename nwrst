# ===============================
# Network Reset (Silent, Admin)
# ===============================

# Auto-elevate to Administrator
$IsAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()
).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

if (-not $IsAdmin) {
    Write-Host "Requesting administrative privileges..." -ForegroundColor Yellow
    Start-Process powershell -Verb runAs -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"$PSCommandPath`""
    exit
}

# Suppress output and errors
$null = ipconfig /release 2>$null
$null = ipconfig /flushdns 2>$null
$null = ipconfig /renew 2>$null
$null = netsh int ip reset 2>$null
$null = netsh winsock reset 2>$null

# Optional: restart automatically (uncomment to enable)
# Restart-Computer -Force -Delay 5 -Confirm:$false

exit
